{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServicosDoProjeto",
      "Effect": "Allow",
      "Action": [
        "dynamodb:*",
        "lambda:*",
        "apigateway:*",
        "cloudfront:*",
        "s3:*",
        "route53:*",
        "cognito-idp:*",
        "ses:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RolesDasLambdas",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:get*",
        "iam:list*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassarRoleParaLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/*"
    }
  ]
}
